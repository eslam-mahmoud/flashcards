<div id="settings" class="container">
    <%- include('partials/header', { showScore: false }) %>
    <h2>Sort the Numbers</h2>

    <div class="setting-group">
        <p class="setting-title">Range of numbers:</p>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="easy" checked> <span>Easy (0-10)</span></label>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="medium"> <span>Medium (10-99)</span></label>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="hard"> <span>Hard (100-999)</span></label>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="advanced"> <span>Advanced (1000-9999)</span></label>
    </div>

    <%- include('partials/start') %>
</div>

<div id="game" class="container">
    <%- include('partials/header', { backLink: '#', backText: 'Back' }) %>
    <h1 id="question"></h1>
    <div id="answerInputs">
        <input type="text" id="answer" placeholder="e.g. 1, 4, 7" autocomplete="off" aria-label="Sorted numbers">
    </div>
    <p class="hint">Separate the numbers with commas or spaces.</p>
    <%- include('partials/answer-buttons') %>
    <%- include('partials/feedback') %>
    <%- include('partials/logs') %>
</div>

<%- contentFor('scripts') %>
<script src="/js/sort.js"></script>
