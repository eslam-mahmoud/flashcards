<div id="settings" class="container">
    <%- include('partials/header', { showScore: false }) %>
    <h2>Before or After?</h2>

    <div class="setting-group">
        <p class="setting-title">Range of numbers:</p>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="10" checked> <span>0 - 10</span></label>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="100"> <span>0 - 100</span></label>
        <label class="checkboxLabel"><input type="radio" name="numberRange" value="1000"> <span>0 - 1000</span></label>
    </div>

    <%- include('partials/start') %>
</div>

<div id="game" class="container">
    <%- include('partials/header', { backLink: '#', backText: 'Back' }) %>
    <h1 id="question"></h1>
    <div id="answerInputs">
        <input type="number" id="answer" inputmode="numeric" aria-label="Answer">
    </div>
    <%- include('partials/answer-buttons') %>
    <%- include('partials/feedback') %>
    <%- include('partials/logs') %>
</div>

<%- contentFor('scripts') %>
<script src="/js/before-after.js"></script>
