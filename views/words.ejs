<div class="container flashcards" id="words">
    <%- include('partials/header', { showScore: false }) %>
    <h1>📚 Let's Learn Words 📚</h1>
    <div class="setting-group">
        <% ['Numbers', 'Sight Words', 'Pronouns', 'Verbs', 'Nouns', 'Body', 'Animals'].forEach(function (type, i) { %>
            <label class="checkboxLabel"><input type="radio" name="wordType" value="<%= type %>" <%= i === 0 ? 'checked' : '' %>> <span><%= type %></span></label>
        <% }) %>
    </div>
    <h1 id="question" class="flashcard"></h1>
    <div class="button-container">
        <button id="newQuestion">Next Word ➜</button>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/words.js"></script>
