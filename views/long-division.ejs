<div id="settings" class="container">
    <%- include('partials/header', { showScore: false }) %>
    <h2>Long Division Practice</h2>

    <div class="setting-group">
        <p class="setting-title">Difficulty:</p>
        <label class="checkboxLabel"><input type="radio" name="difficulty" value="easy" checked> <span>Easy (2-digit ÷ 1-digit)</span></label>
        <label class="checkboxLabel"><input type="radio" name="difficulty" value="medium"> <span>Medium (3-digit ÷ 1-digit)</span></label>
        <label class="checkboxLabel"><input type="radio" name="difficulty" value="hard"> <span>Hard (3-digit ÷ 2-digit)</span></label>
    </div>

    <%- include('partials/start') %>
</div>

<div id="game" class="container long-division">
    <%- include('partials/header', { backLink: '#', backText: 'Back' }) %>
    <div id="question"></div>
    <div id="answerInputs">
        <input type="number" id="quotient" placeholder="Quotient" inputmode="numeric" aria-label="Quotient">
        <input type="number" id="remainder" placeholder="Remainder" inputmode="numeric" aria-label="Remainder">
    </div>
    <p class="hint">Leave the remainder empty if it is 0.</p>
    <%- include('partials/answer-buttons') %>
    <%- include('partials/feedback') %>
    <%- include('partials/logs') %>
</div>

<%- contentFor('scripts') %>
<script src="/js/long-division.js"></script>
