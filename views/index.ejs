<div class="splash-container">
    <h1>🎊 Welcome to Learning Activities 🎊</h1>
    <p class="intro-text">Select an activity to start:</p>
    <div class="activity-stack">
        <% activities.forEach(function (activity) { %>
            <a href="/<%= activity.slug %>" class="stack-btn <%= activity.slug %>-btn"><%= activity.label %></a>
        <% }) %>
    </div>
</div>
