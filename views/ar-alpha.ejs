<div class="container flashcards" dir="rtl" lang="ar">
    <%- include('partials/header', { showScore: false, backText: 'الرئيسية', backArrow: '→' }) %>
    <h1>📚 تعلم الحروف العربية 📚</h1>
    <div class="setting-group">
        <label class="checkboxLabel"><input type="radio" name="letterType" value="sorted" checked> <span>مرتب</span></label>
        <label class="checkboxLabel"><input type="radio" name="letterType" value="random"> <span>عشوائي</span></label>
        <label class="checkboxLabel"><input type="checkbox" id="singleLetter" checked> <span>حرف منفرد</span></label>
    </div>
    <h1 id="question" class="flashcard arabic-letter"></h1>
    <div class="button-container">
        <button id="newQuestion">التالي</button>
    </div>
</div>

<%- contentFor('scripts') %>
<script src="/js/ar-alpha.js"></script>
