<div class="container">
    <%- include('partials/header') %>
    <h2>What time is it?</h2>
    <div class="clock">
        <% for (let i = 1; i <= 12; i++) { const angle = i * Math.PI / 6; %>
            <span class="number" style="left: <%= (50 + 40 * Math.sin(angle)).toFixed(2) %>%; top: <%= (50 - 40 * Math.cos(angle)).toFixed(2) %>%;"><%= i %></span>
        <% } %>
        <div class="hand hour-hand" id="hourHand"></div>
        <div class="hand minute-hand" id="minuteHand"></div>
    </div>

    <div id="answerInputs" class="clock-inputs">
        <label>Hours <input type="number" id="hours" min="1" max="12" inputmode="numeric"></label>
        <span class="clock-colon">:</span>
        <label>Minutes <input type="number" id="minutes" min="0" max="59" inputmode="numeric"></label>
    </div>

    <%- include('partials/answer-buttons') %>
    <%- include('partials/feedback') %>
    <%- include('partials/logs') %>
</div>

<%- contentFor('scripts') %>
<script src="/js/clock.js"></script>
